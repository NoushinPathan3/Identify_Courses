<suite threadcount="5" name="OrangeHRM Suite" parallel="tests">
    <listeners>
        <listener class-name="listeners.ExtentTestListener"/>
    </listeners>

    <test name="Chrome Test">
        <parameter name="Browser" value="chrome"/>
        <classes>
            <class name="tests.OrangeHRMTest"/>
        </classes>
    </test>

    <test name="Edge Test">
        <parameter name="Browser" value="edge"/>
        <classes>
            <class name="tests.OrangeHRMTest"/>
        </classes>
    </test>
</suite>